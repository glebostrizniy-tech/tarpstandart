PORT=8080
NODE_ENV=production
# Resend без своего домена шлёт только на почту аккаунта Resend.
CONTACT_RECIPIENT_EMAIL=glebostrizniy@bk.ru
# Бесплатный Render блокирует SMTP (465/587). Для формы задай HTTPS-ключ:
# https://resend.com → API Keys → RESEND_API_KEY
RESEND_API_KEY=
RESEND_FROM=ТарпСтандарт <onboarding@resend.dev>
# SMTP только на платном Render (Starter и выше) или локально:
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=sale@tarpstandart.ru
SMTP_PASS=
SMTP_FROM=sale@tarpstandart.ru
CORS_ORIGINS=https://glebostrizniy-tech.github.io,https://tarpstandart.ru,https://www.tarpstandart.ru
